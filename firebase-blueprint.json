        "actorUserId": { "type": "string", "maxLength": 40 },
        "targetUserId": { "type": "string", "maxLength": 40 },
        "serviceId": { "type": "string", "maxLength": 64 },
        "reason": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["logId", "entityType", "entityId", "action", "actorUid", "actorUserId", "createdAt"]
    }
