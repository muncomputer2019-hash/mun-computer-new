        "managerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serviceId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serviceName": { "type": "string", "maxLength": 160 },
        "allowedActions": { "type": "array" },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "EXPIRED", "REVOKED"] },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "approvedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["permissionId", "staffUid", "staffUserId", "managerUid", "serviceId", "allowedActions", "status", "approvedByUid", "createdAt", "updatedAt"]
    },
