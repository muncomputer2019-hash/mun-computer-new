    // =========================================================================
    // CSC Digital Service Center Collections (Parts 1-18)
    // =========================================================================
    function isValidCscCategoryDoc(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'active', 'createdByUid', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly([
        'id', 'code', 'name', 'icon', 'description', 'displayOrder',
        'active', 'noticeText', 'moduleTag', 'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isBoundedString(data.code, 2, 40) &&
      isBoundedString(data.name, 2, 160) &&
      data.active is bool &&
      isValidId(data.createdByUid) &&
      (!('description' in data) || isBoundedString(data.description, 0, 500)) &&
      (!('noticeText' in data) || isBoundedString(data.noticeText, 0, 600)) &&
      (!('icon' in data) || isBoundedString(data.icon, 0, 64)) &&
      (!('moduleTag' in data) || data.moduleTag in ['GENERAL', 'PMJAY', 'MMSBY', 'NPCI', 'CYBER_CRIME', 'PVC', 'GRIEVANCE', 'RTI']) &&
      (!('displayOrder' in data) || data.displayOrder is number) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCscServiceOverrideDoc(data) {
      return data.keys().hasAll(['serviceId', 'rateConfigured', 'availability', 'active', 'updatedByUid', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly([
        'serviceId', 'code', 'categoryId', 'categoryName', 'subGroup', 'name', 'description',
        'serviceCharge', 'govtFee', 'totalAmount', 'unitType', 'rateConfigured', 'effectiveDate',
        'requiredDocuments', 'availability', 'active', 'moduleTag', 'updatedBy', 'updatedByUid',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.serviceId) &&
      data.rateConfigured is bool &&
      data.availability in ['Available', 'Unavailable'] &&
      data.active is bool &&
      isValidId(data.updatedByUid) &&
      (!('name' in data) || isBoundedString(data.name, 2, 200)) &&
      (!('serviceCharge' in data) || data.serviceCharge == null || (data.serviceCharge is number && data.serviceCharge >= 0)) &&
      (!('govtFee' in data) || data.govtFee == null || (data.govtFee is number && data.govtFee >= 0)) &&
      (!('totalAmount' in data) || data.totalAmount == null || (data.totalAmount is number && data.totalAmount >= 0)) &&
      (!('unitType' in data) || data.unitType == null || isBoundedString(data.unitType, 2, 40)) &&
      (!('requiredDocuments' in data) || (data.requiredDocuments is list && data.requiredDocuments.size() <= 30 && (data.requiredDocuments.size() == 0 || data.requiredDocuments[0] is string))) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCscRateHistoryDoc(data) {
      return data.keys().hasAll(['id', 'serviceId', 'newServiceCharge', 'newGovtFee', 'newTotalAmount', 'newUnitType', 'createdByUid', 'createdAt']) &&
      data.keys().hasOnly([
        'id', 'serviceId', 'serviceCode', 'serviceName', 'categoryName', 'adminId',
        'oldServiceCharge', 'newServiceCharge', 'oldGovtFee', 'newGovtFee',
        'oldTotalAmount', 'newTotalAmount', 'oldUnitType', 'newUnitType',
        'effectiveDate', 'changeReason', 'changedAt', 'createdByUid', 'createdAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.serviceId) &&
      data.newServiceCharge is number && data.newServiceCharge >= 0 &&
      data.newGovtFee is number && data.newGovtFee >= 0 &&
      data.newTotalAmount is number && data.newTotalAmount >= 0 &&
      isBoundedString(data.newUnitType, 2, 40) &&
      isValidId(data.createdByUid) &&
      data.createdAt is timestamp;
    }

    function isValidPvcSlabDoc(data) {
      return data.keys().hasAll(['id', 'mode', 'minQty', 'maxQty', 'ratePerCard', 'active', 'createdByUid', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['id', 'mode', 'minQty', 'maxQty', 'ratePerCard', 'active', 'updatedBy', 'createdByUid', 'createdAt', 'updatedAt']) &&
      isValidId(data.id) &&
      data.mode in ['INDIVIDUAL', 'WHOLESALE'] &&
      data.minQty is number && data.minQty >= 1 &&
      data.maxQty is number && data.maxQty >= data.minQty &&
      data.ratePerCard is number && data.ratePerCard >= 0 &&
      data.active is bool &&
      isValidId(data.createdByUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidWholesaleShopDoc(data) {
      return data.keys().hasAll(['id', 'shopCode', 'shopName', 'ownerName', 'mobile', 'active', 'createdByUid', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['id', 'shopCode', 'shopName', 'ownerName', 'mobile', 'altMobile', 'address', 'registrationDate', 'remarks', 'active', 'createdByUid', 'createdAt', 'updatedAt']) &&
      isValidId(data.id) &&
      isBoundedString(data.shopName, 2, 160) &&
      isBoundedString(data.ownerName, 2, 120) &&
      isBoundedString(data.mobile, 8, 24) &&
      data.active is bool &&
      isValidId(data.createdByUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCscOrderDoc(data) {
      return data.keys().hasAll([
        'orderId', 'customerId', 'customerName', 'mobile', 'totalAmount',
        'totalPaid', 'remainingDue', 'applicationStatus', 'paymentStatus',
        'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'orderId', 'customerId', 'customerUid', 'customerName', 'mobile',
        'selectedCategoryId', 'selectedCategoryName', 'selectedServiceId', 'selectedServiceName',
        'items', 'applicationDetails', 'documents', 'serviceCharge', 'govtFee',
        'totalAmount', 'advancePayment', 'additionalPayments', 'refundedAmount',
        'totalPaid', 'remainingDue', 'orderDate', 'applicationStatus', 'paymentStatus',
        'operatorId', 'operatorName', 'adminRemarks', 'moduleTag', 'ekycMethod',
        'ekycStatus', 'externalAckNo', 'pmjayDetails', 'mmsbyDetails', 'npciDetails',
        'cyberCrimeDetails', 'payments', 'statusHistory', 'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.orderId) &&
      isBoundedString(data.customerName, 2, 160) &&
      isBoundedString(data.mobile, 8, 24) &&
      data.totalAmount is number && data.totalAmount >= 0 &&
      data.totalPaid is number && data.totalPaid >= 0 &&
      data.remainingDue is number && data.remainingDue >= 0 &&
      data.applicationStatus in [
        'Draft', 'Pending', 'Document Required', 'Document Verified',
        'Ready to Process', 'Processing', 'e-KYC Pending', 'e-KYC Completed',
        'Submitted', 'Under Verification', 'Approved', 'Rejected',
        'Card Generated', 'Card Downloaded', 'Delivered', 'Completed', 'Cancelled'
      ] &&
      data.paymentStatus in ['Unpaid', 'Partial', 'Paid', 'Due', 'Refunded'] &&
      isValidId(data.createdByUid) &&
      (!('customerUid' in data) || isBoundedString(data.customerUid, 0, 128)) &&
      (!('items' in data) || (data.items is list && data.items.size() <= 30 && (data.items.size() == 0 || data.items[0] is map))) &&
      (!('payments' in data) || (data.payments is list && data.payments.size() <= 50 && (data.payments.size() == 0 || data.payments[0] is map))) &&
      (!('documents' in data) || (data.documents is list && data.documents.size() <= 30 && (data.documents.size() == 0 || data.documents[0] is map))) &&
      (!('statusHistory' in data) || (data.statusHistory is list && data.statusHistory.size() <= 50 && (data.statusHistory.size() == 0 || data.statusHistory[0] is map))) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPvcOrderDoc(data) {
      return data.keys().hasAll([
        'orderId', 'orderMode', 'customerName', 'mobile', 'totalCards',
        'grandTotal', 'totalPaid', 'remainingDue', 'paymentStatus', 'deliveryStatus',
        'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'orderId', 'orderMode', 'customerId', 'customerUid', 'customerName',
        'mobile', 'shopId', 'shopName', 'shopOwnerName', 'address', 'items',
        'totalCards', 'grandTotal', 'advancePayment', 'additionalPayments',
        'totalPaid', 'remainingDue', 'paymentStatus', 'deliveryStatus', 'orderDate',
        'operatorId', 'operatorName', 'remarks', 'payments', 'createdByUid',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.orderId) &&
      data.orderMode in ['INDIVIDUAL', 'WHOLESALE'] &&
      isBoundedString(data.customerName, 2, 160) &&
      data.totalCards is number && data.totalCards >= 1 &&
      data.grandTotal is number && data.grandTotal >= 0 &&
      data.paymentStatus in ['Unpaid', 'Partial', 'Paid', 'Due', 'Refunded'] &&
      data.deliveryStatus in ['Pending', 'Printing', 'Ready for Delivery', 'Delivered', 'Cancelled'] &&
      isValidId(data.createdByUid) &&
      (!('items' in data) || (data.items is list && data.items.size() <= 30 && (data.items.size() == 0 || data.items[0] is map))) &&
      (!('payments' in data) || (data.payments is list && data.payments.size() <= 50 && (data.payments.size() == 0 || data.payments[0] is map))) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidGrievanceDoc(data) {
      return data.keys().hasAll([
        'internalTrackingId', 'customerName', 'mobile', 'complaintCategory',
        'serviceType', 'complaintSubject', 'complaintStatus', 'paymentStatus',
        'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'internalTrackingId', 'externalAckNo', 'customerId', 'customerUid',
        'customerName', 'mobile', 'address', 'district', 'blockOrMunicipality',
        'complaintCategory', 'serviceType', 'department', 'authority',
        'complaintSubject', 'complaintDetails', 'uploadedDocuments', 'serviceCharge',
        'govtFee', 'totalAmount', 'paidAmount', 'remainingDue', 'paymentStatus',
        'submissionDate', 'followUpDate', 'complaintStatus', 'isRti', 'rtiType',
        'pioName', 'faaName', 'replySummary', 'adminRemarks', 'operatorId',
        'operatorName', 'followUps', 'statusHistory', 'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.internalTrackingId) &&
      isBoundedString(data.customerName, 2, 160) &&
      isBoundedString(data.complaintSubject, 3, 240) &&
      data.serviceType in [
        'Application Drafting', 'Online Grievance Filing Assistance',
        'RTI & Appeal Assistance', 'Complaint Status Tracking',
        'Acknowledgement Download', 'Follow-up Assistance'
      ] &&
      data.complaintStatus in [
        'Draft', 'Document Pending', 'Ready to Submit', 'Submitted',
        'Acknowledgement Received', 'Under Process', 'Forwarded',
        'Reply Received', 'Resolved', 'Rejected', 'Closed'
      ] &&
      data.paymentStatus in ['Unpaid', 'Partial', 'Paid', 'Due', 'Refunded'] &&
      isValidId(data.createdByUid) &&
      (!('followUps' in data) || (data.followUps is list && data.followUps.size() <= 50 && (data.followUps.size() == 0 || data.followUps[0] is map))) &&
      (!('statusHistory' in data) || (data.statusHistory is list && data.statusHistory.size() <= 50 && (data.statusHistory.size() == 0 || data.statusHistory[0] is map))) &&
      (!('uploadedDocuments' in data) || (data.uploadedDocuments is list && data.uploadedDocuments.size() <= 30 && (data.uploadedDocuments.size() == 0 || data.uploadedDocuments[0] is map))) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCscDocumentRecord(data) {
      return data.keys().hasAll([
        'docId', 'customerId', 'category', 'docName', 'verificationStatus',
        'uploadedBy', 'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'docId', 'customerId', 'customerUid', 'orderId', 'grievanceId',
        'category', 'docName', 'mimeType', 'fileSizeBytes', 'contentBase64',
        'verificationStatus', 'rejectionReason', 'uploadedBy', 'verifiedBy',
        'uploadedAt', 'verifiedAt', 'auditTrail', 'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.docId) &&
      isBoundedString(data.customerId, 2, 64) &&
      isBoundedString(data.docName, 2, 200) &&
      data.verificationStatus in ['Pending', 'Verified', 'Rejected', 'Re-upload Requested'] &&
      isValidId(data.createdByUid) &&
      (!('auditTrail' in data) || (data.auditTrail is list && data.auditTrail.size() <= 50 && (data.auditTrail.size() == 0 || data.auditTrail[0] is map))) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /cscCustomCategories/{catId} {
      allow get: if isValidId(catId) && isVerifiedUser();
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().active in [true, false]);
      allow create: if isValidId(catId) && isAdmin() && isValidCscCategoryDoc(incoming()) && incoming().id == catId && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(catId) && isAdmin() && isValidCscCategoryDoc(incoming()) && incoming().id == existing().id && incoming().createdByUid == existing().createdByUid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(catId) && isAdmin();
    }

    match /cscServiceOverrides/{serviceId} {
      allow get: if isValidId(serviceId) && isVerifiedUser();
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().active in [true, false]);
      allow create: if isValidId(serviceId) && isAdmin() && isValidCscServiceOverrideDoc(incoming()) && incoming().serviceId == serviceId && incoming().updatedByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(serviceId) && isAdmin() && isValidCscServiceOverrideDoc(incoming()) && incoming().serviceId == existing().serviceId && incoming().createdAt == existing().createdAt && incoming().updatedByUid == request.auth.uid && incoming().updatedAt == request.time;
      allow delete: if isValidId(serviceId) && isAdmin();
    }

    match /cscRateHistory/{entryId} {
      allow get: if isValidId(entryId) && isActiveTeamMember();
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().createdByUid == request.auth.uid);
      allow create: if isValidId(entryId) && isAdmin() && isValidCscRateHistoryDoc(incoming()) && incoming().id == entryId && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time;
    }

    match /pvcSlabs/{slabId} {
      allow get: if isValidId(slabId) && isVerifiedUser();
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().active in [true, false]);
      allow create: if isValidId(slabId) && isAdmin() && isValidPvcSlabDoc(incoming()) && incoming().id == slabId && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(slabId) && isAdmin() && isValidPvcSlabDoc(incoming()) && incoming().id == existing().id && incoming().createdByUid == existing().createdByUid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(slabId) && isAdmin();
    }

    match /wholesaleShops/{shopId} {
      allow get: if isValidId(shopId) && isActiveTeamMember();
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().createdByUid == request.auth.uid);
      allow create: if isValidId(shopId) && isActiveTeamMember() && isValidWholesaleShopDoc(incoming()) && incoming().id == shopId && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(shopId) && isActiveTeamMember() && isValidWholesaleShopDoc(incoming()) && incoming().id == existing().id && incoming().createdByUid == existing().createdByUid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (isAdmin() || existing().createdByUid == request.auth.uid);
      allow delete: if isValidId(shopId) && isAdmin();
    }

    match /cscOrders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isVerifiedUser() && (existing().createdByUid == request.auth.uid || existing().customerUid == request.auth.uid)));
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && (existing().createdByUid == request.auth.uid || existing().customerUid == request.auth.uid));
      allow create: if isValidId(orderId) && isActiveTeamMember() && isValidCscOrderDoc(incoming()) && incoming().orderId == orderId && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(orderId) && isActiveTeamMember() && isValidCscOrderDoc(incoming()) && incoming().orderId == existing().orderId && incoming().createdByUid == existing().createdByUid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (isAdmin() || existing().createdByUid == request.auth.uid);
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /pvcOrders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isVerifiedUser() && (existing().createdByUid == request.auth.uid || existing().customerUid == request.auth.uid)));
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && (existing().createdByUid == request.auth.uid || existing().customerUid == request.auth.uid));
      allow create: if isValidId(orderId) && isActiveTeamMember() && isValidPvcOrderDoc(incoming()) && incoming().orderId == orderId && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(orderId) && isActiveTeamMember() && isValidPvcOrderDoc(incoming()) && incoming().orderId == existing().orderId && incoming().createdByUid == existing().createdByUid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (isAdmin() || existing().createdByUid == request.auth.uid);
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /cscGrievances/{trackingId} {
      allow get: if isValidId(trackingId) && (isAdmin() || (isVerifiedUser() && (existing().createdByUid == request.auth.uid || existing().customerUid == request.auth.uid)));
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && (existing().createdByUid == request.auth.uid || existing().customerUid == request.auth.uid));
      allow create: if isValidId(trackingId) && isVerifiedUser() && isValidGrievanceDoc(incoming()) && incoming().internalTrackingId == trackingId && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time && (isActiveTeamMember() || incoming().customerUid == request.auth.uid);
      allow update: if isValidId(trackingId) && isActiveTeamMember() && isValidGrievanceDoc(incoming()) && incoming().internalTrackingId == existing().internalTrackingId && incoming().createdByUid == existing().createdByUid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (isAdmin() || existing().createdByUid == request.auth.uid);
      allow delete: if isValidId(trackingId) && isAdmin();
    }

    match /cscDocuments/{docId} {
      allow get: if isValidId(docId) && (isAdmin() || (isVerifiedUser() && (existing().createdByUid == request.auth.uid || existing().customerUid == request.auth.uid)));
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && (existing().createdByUid == request.auth.uid || existing().customerUid == request.auth.uid));
      allow create: if isValidId(docId) && isVerifiedUser() && isValidCscDocumentRecord(incoming()) && incoming().docId == docId && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time && (isActiveTeamMember() || incoming().customerUid == request.auth.uid);
      allow update: if isValidId(docId) && isActiveTeamMember() && isValidCscDocumentRecord(incoming()) && incoming().docId == existing().docId && incoming().createdByUid == existing().createdByUid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (isAdmin() || existing().createdByUid == request.auth.uid);
      allow delete: if isValidId(docId) && isAdmin();
    }

    // =========================================================================
    // Phase 02: 3-Tier Service RBAC & Governance Collections
    // =========================================================================
    function isValidDepartmentDoc(data) {
      return data.keys().hasAll(['departmentCode', 'name', 'status', 'createdByUid', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['id', 'departmentCode', 'name', 'description', 'status', 'createdByUid', 'createdAt', 'updatedAt']) &&
      isValidId(data.departmentCode) &&
      isBoundedString(data.name, 2, 120) &&
      data.status in ['ACTIVE', 'INACTIVE'] &&
      isValidId(data.createdByUid) &&
      (!('description' in data) || isBoundedString(data.description, 0, 400)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidManagerServiceAssignmentDoc(data) {
      return data.keys().hasAll([
        'assignmentId', 'managerUid', 'managerUserId', 'serviceId',
        'allowedActions', 'status', 'assignedByUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'assignmentId', 'managerUid', 'managerUserId', 'serviceId', 'serviceName',
        'departmentCode', 'allowedActions', 'status', 'expiresAt', 'notes',
        'assignedByUid', 'assignedByUserId', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.assignmentId) &&
      isValidId(data.managerUid) &&
      isBoundedString(data.managerUserId, 3, 40) &&
      isValidId(data.serviceId) &&
      data.allowedActions is list && data.allowedActions.size() >= 1 && data.allowedActions.size() <= 12 &&
      data.allowedActions[0] is string && isBoundedString(data.allowedActions[0], 2, 24) &&
      data.status in ['ACTIVE', 'SUSPENDED', 'EXPIRED', 'REVOKED'] &&
      isValidId(data.assignedByUid) &&
      (!('serviceName' in data) || isBoundedString(data.serviceName, 0, 160)) &&
      (!('departmentCode' in data) || isBoundedString(data.departmentCode, 0, 40)) &&
      (!('expiresAt' in data) || data.expiresAt == null || isBoundedString(data.expiresAt, 0, 64)) &&
      (!('notes' in data) || isBoundedString(data.notes, 0, 400)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidStaffServiceRequestDoc(data) {
      return data.keys().hasAll([
        'requestId', 'managerUid', 'managerUserId', 'staffUid', 'staffUserId',
        'serviceId', 'requestedActions', 'status', 'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'requestId', 'managerAssignmentId', 'managerUid', 'managerUserId',
        'staffUid', 'staffUserId', 'serviceId', 'serviceName', 'requestedActions',
        'status', 'expiresAt', 'requestNotes', 'reviewedByUid', 'reviewedByUserId',
        'reviewNotes', 'reviewedAt', 'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.requestId) &&
      isValidId(data.managerUid) &&
      isBoundedString(data.managerUserId, 3, 40) &&
      isValidId(data.staffUid) &&
      isBoundedString(data.staffUserId, 3, 40) &&
      isValidId(data.serviceId) &&
      data.requestedActions is list && data.requestedActions.size() >= 1 && data.requestedActions.size() <= 12 &&
      data.requestedActions[0] is string && isBoundedString(data.requestedActions[0], 2, 24) &&
      data.status in ['PENDING_ADMIN_APPROVAL', 'APPROVED', 'REJECTED'] &&
      isValidId(data.createdByUid) &&
      (!('managerAssignmentId' in data) || isValidId(data.managerAssignmentId)) &&
      (!('serviceName' in data) || isBoundedString(data.serviceName, 0, 160)) &&
      (!('expiresAt' in data) || data.expiresAt == null || isBoundedString(data.expiresAt, 0, 64)) &&
      (!('requestNotes' in data) || isBoundedString(data.requestNotes, 0, 400)) &&
      (!('reviewNotes' in data) || isBoundedString(data.reviewNotes, 0, 400)) &&
      (!('reviewedByUid' in data) || data.reviewedByUid == null || isValidId(data.reviewedByUid)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidStaffServicePermissionDoc(data) {
      return data.keys().hasAll([
        'permissionId', 'staffUid', 'staffUserId', 'managerUid',
        'serviceId', 'allowedActions', 'status', 'approvedByUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'permissionId', 'requestId', 'managerAssignmentId',
        'staffUid', 'staffUserId', 'managerUid', 'serviceId', 'serviceName',
        'allowedActions', 'status', 'expiresAt', 'approvedByUid',
        'suspendedReason', 'revokedReason', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.permissionId) &&
      isValidId(data.staffUid) &&
      isBoundedString(data.staffUserId, 3, 40) &&
      isValidId(data.managerUid) &&
      isValidId(data.serviceId) &&
      data.allowedActions is list && data.allowedActions.size() >= 1 && data.allowedActions.size() <= 12 &&
      data.allowedActions[0] is string && isBoundedString(data.allowedActions[0], 2, 24) &&
      data.status in ['ACTIVE', 'SUSPENDED', 'EXPIRED', 'REVOKED'] &&
      isValidId(data.approvedByUid) &&
      (!('serviceName' in data) || isBoundedString(data.serviceName, 0, 160)) &&
      (!('expiresAt' in data) || data.expiresAt == null || isBoundedString(data.expiresAt, 0, 64)) &&
      (!('suspendedReason' in data) || isBoundedString(data.suspendedReason, 0, 300)) &&
      (!('revokedReason' in data) || isBoundedString(data.revokedReason, 0, 300)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidServiceApprovalLogDoc(data) {
      return data.keys().hasAll([
        'logId', 'entityType', 'entityId', 'action', 'actorUid', 'actorUserId', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'logId', 'entityType', 'entityId', 'action',
        'actorUid', 'actorUserId', 'targetUserId', 'serviceId', 'reason', 'createdAt'
      ]) &&
      isValidId(data.logId) &&
      isBoundedString(data.entityType, 2, 64) &&
      isBoundedString(data.entityId, 2, 64) &&
      isBoundedString(data.action, 2, 64) &&
      isValidId(data.actorUid) &&
      isBoundedString(data.actorUserId, 1, 40) &&
      (!('targetUserId' in data) || isBoundedString(data.targetUserId, 0, 40)) &&
      (!('serviceId' in data) || isBoundedString(data.serviceId, 0, 64)) &&
      (!('reason' in data) || isBoundedString(data.reason, 0, 400)) &&
      data.createdAt is timestamp;
    }

    match /departments/{departmentCode} {
      allow get: if isValidId(departmentCode) && isActiveTeamMember();
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().status in ['ACTIVE', 'INACTIVE']);
      allow create: if isValidId(departmentCode) && isAdmin() && isValidDepartmentDoc(incoming()) && incoming().departmentCode == departmentCode && incoming().createdByUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(departmentCode) && isAdmin() && isValidDepartmentDoc(incoming()) && incoming().departmentCode == existing().departmentCode && incoming().createdByUid == existing().createdByUid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(departmentCode) && isAdmin();
    }

    match /managerServiceAssignments/{assignmentId} {
      allow get: if isValidId(assignmentId) && (isAdmin() || (isActiveTeamMember() && existing().managerUid == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().managerUid == request.auth.uid);
      allow create: if isValidId(assignmentId) &&
        isAdmin() &&
        isValidManagerServiceAssignmentDoc(incoming()) &&
        incoming().assignmentId == assignmentId &&
        incoming().assignedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().managerUid));
      allow update: if isValidId(assignmentId) &&
        isAdmin() &&
        isValidManagerServiceAssignmentDoc(incoming()) &&
        incoming().assignmentId == existing().assignmentId &&
        incoming().managerUid == existing().managerUid &&
        incoming().serviceId == existing().serviceId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(assignmentId) && isAdmin();
    }

    match /staffServiceRequests/{requestId} {
      allow get: if isValidId(requestId) && (isAdmin() || (isActiveTeamMember() && (existing().managerUid == request.auth.uid || existing().staffUid == request.auth.uid)));
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && (existing().managerUid == request.auth.uid || existing().staffUid == request.auth.uid));
      allow create: if isValidId(requestId) &&
        isManager() &&
        isValidStaffServiceRequestDoc(incoming()) &&
        incoming().requestId == requestId &&
        incoming().managerUid == request.auth.uid &&
        incoming().createdByUid == request.auth.uid &&
        incoming().status == 'PENDING_ADMIN_APPROVAL' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().staffUid)) &&
        'managerAssignmentId' in incoming() &&
        exists(/databases/$(database)/documents/managerServiceAssignments/$(incoming().managerAssignmentId)) &&
        get(/databases/$(database)/documents/managerServiceAssignments/$(incoming().managerAssignmentId)).data.managerUid == request.auth.uid &&
        get(/databases/$(database)/documents/managerServiceAssignments/$(incoming().managerAssignmentId)).data.status == 'ACTIVE';
      allow update: if isValidId(requestId) &&
        isAdmin() &&
        isValidStaffServiceRequestDoc(incoming()) &&
        incoming().requestId == existing().requestId &&
        incoming().managerUid == existing().managerUid &&
        incoming().staffUid == existing().staffUid &&
        incoming().serviceId == existing().serviceId &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().status == 'PENDING_ADMIN_APPROVAL';
      allow delete: if isValidId(requestId) && isAdmin();
    }

    match /staffServicePermissions/{permissionId} {
      allow get: if isValidId(permissionId) && (isAdmin() || (isActiveTeamMember() && (existing().staffUid == request.auth.uid || existing().managerUid == request.auth.uid)));
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && (existing().staffUid == request.auth.uid || existing().managerUid == request.auth.uid));
      allow create: if isValidId(permissionId) &&
        isAdmin() &&
        isValidStaffServicePermissionDoc(incoming()) &&
        incoming().permissionId == permissionId &&
        incoming().approvedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().staffUid));
      allow update: if isValidId(permissionId) &&
        isAdmin() &&
        isValidStaffServicePermissionDoc(incoming()) &&
        incoming().permissionId == existing().permissionId &&
        incoming().staffUid == existing().staffUid &&
        incoming().serviceId == existing().serviceId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(permissionId) && isAdmin();
    }

    match /serviceApprovalLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(logId) &&
        (isAdmin() || isManager()) &&
        isValidServiceApprovalLogDoc(incoming()) &&
        incoming().logId == logId &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time;
    }
  }
}
