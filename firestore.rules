rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'muncomputer2019@gmail.com' ||
        request.auth.token.email == 'mamunreja335@gmail.com'
      );
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isActiveTeamMember() {
      return isAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'MANAGER', 'STAFF', 'AUDITOR']
      );
    }

    function isManager() {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MANAGER';
    }

    function isProtectedMasterAdmin(data) {
      return ('isMasterAdmin' in data && data.isMasterAdmin == true) ||
        data.userId in ['MC2627110001', 'MC262711001', 'MC-AD-202613-0001'];
    }

    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // =========================================================================
    // Entity Validation Blueprints
    // =========================================================================
    function isValidUserPublic(data) {
      return data.keys().hasAll([
        'uid', 'userId', 'fullName', 'role', 'status', 'branch',
        'mobileVerified', 'emailVerified', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'userId', 'fullName', 'role', 'status', 'branch',
        'designation', 'departmentCode', 'joiningDate', 'profilePhotoUrl',
        'isMasterAdmin', 'mobileVerified', 'emailVerified', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      isBoundedString(data.userId, 3, 40) &&
      isBoundedString(data.fullName, 1, 120) &&
      data.role in ['ADMIN', 'MANAGER', 'STAFF', 'AUDITOR', 'CUSTOMER'] &&
      data.status in ['PENDING', 'ACTIVE', 'SUSPENDED', 'DEACTIVATED', 'REJECTED'] &&
      isBoundedString(data.branch, 1, 120) &&
      (!('designation' in data) || isBoundedString(data.designation, 0, 120)) &&
      (!('departmentCode' in data) || isBoundedString(data.departmentCode, 0, 40)) &&
      (!('joiningDate' in data) || isBoundedString(data.joiningDate, 0, 32)) &&
      (!('profilePhotoUrl' in data) || isBoundedString(data.profilePhotoUrl, 0, 500)) &&
      (!('isMasterAdmin' in data) || data.isMasterAdmin is bool) &&
      data.mobileVerified is bool &&
      data.emailVerified is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'mobile', 'address', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['uid', 'email', 'mobile', 'address', 'totpEnabled', 'totpSecret', 'createdAt', 'updatedAt']) &&
      isValidId(data.uid) &&
      isBoundedString(data.email, 0, 160) &&
      isBoundedString(data.mobile, 0, 32) &&
      isBoundedString(data.address, 0, 300) &&
      (!('totpEnabled' in data) || data.totpEnabled is bool) &&
      (!('totpSecret' in data) || isBoundedString(data.totpSecret, 0, 128)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAdminMarker(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt', 'updatedAt']) &&
      isValidId(data.uid) &&
      isBoundedString(data.email, 3, 160) &&
      isBoundedString(data.grantedBy, 1, 128) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll([
        'customerId', 'fullName', 'gender', 'mobile', 'village',
        'segment', 'status', 'createdByUid', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'customerId', 'fullName', 'fatherOrHusbandName', 'dob', 'gender',
        'mobile', 'whatsapp', 'email', 'aadhaarMasked', 'panNumber', 'voterId',
        'village', 'postOffice', 'policeStation', 'district', 'pinCode',
        'presentAddress', 'permanentAddress', 'sameAsPresent', 'segment', 'crmTag',
        'status', 'verificationStatus', 'mobileOtpVerifiedAt', 'consents',
        'consentHistory', 'contactHistory', 'notesAndFollowUps', 'deletedAt',
        'createdByUid', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.customerId) &&
      isBoundedString(data.fullName, 2, 120) &&
      data.gender in ['Male', 'Female', 'Other'] &&
      isBoundedString(data.mobile, 8, 24) &&
      isBoundedString(data.village, 1, 120) &&
      data.segment in ['Individual', 'Corporate', 'Government'] &&
      data.status in ['Active', 'Inactive', 'Blocked'] &&
      isValidId(data.createdByUid) &&
      isBoundedString(data.createdBy, 1, 64) &&
      (!('fatherOrHusbandName' in data) || isBoundedString(data.fatherOrHusbandName, 0, 120)) &&
      (!('dob' in data) || isBoundedString(data.dob, 0, 32)) &&
      (!('whatsapp' in data) || isBoundedString(data.whatsapp, 0, 24)) &&
      (!('email' in data) || isBoundedString(data.email, 0, 160)) &&
      (!('aadhaarMasked' in data) || isBoundedString(data.aadhaarMasked, 0, 24)) &&
      (!('panNumber' in data) || isBoundedString(data.panNumber, 0, 20)) &&
      (!('voterId' in data) || isBoundedString(data.voterId, 0, 32)) &&
      (!('postOffice' in data) || isBoundedString(data.postOffice, 0, 120)) &&
      (!('policeStation' in data) || isBoundedString(data.policeStation, 0, 120)) &&
      (!('district' in data) || isBoundedString(data.district, 0, 120)) &&
      (!('pinCode' in data) || isBoundedString(data.pinCode, 0, 16)) &&
      (!('presentAddress' in data) || isBoundedString(data.presentAddress, 0, 300)) &&
      (!('permanentAddress' in data) || isBoundedString(data.permanentAddress, 0, 300)) &&
      (!('sameAsPresent' in data) || data.sameAsPresent is bool) &&
      (!('crmTag' in data) || isBoundedString(data.crmTag, 0, 64)) &&
      (!('verificationStatus' in data) || isBoundedString(data.verificationStatus, 0, 64)) &&
      (!('consents' in data) || (data.consents is list && data.consents.size() <= 15 && (data.consents.size() == 0 || data.consents[0] is map))) &&
      (!('consentHistory' in data) || (data.consentHistory is list && data.consentHistory.size() <= 100 && (data.consentHistory.size() == 0 || data.consentHistory[0] is map))) &&
      (!('contactHistory' in data) || (data.contactHistory is list && data.contactHistory.size() <= 50 && (data.contactHistory.size() == 0 || data.contactHistory[0] is map))) &&
      (!('notesAndFollowUps' in data) || (data.notesAndFollowUps is list && data.notesAndFollowUps.size() <= 100 && (data.notesAndFollowUps.size() == 0 || data.notesAndFollowUps[0] is map))) &&
      (!('deletedAt' in data) || data.deletedAt == null || isBoundedString(data.deletedAt, 0, 64)) &&
      (!('mobileOtpVerifiedAt' in data) || data.mobileOtpVerifiedAt == null || isBoundedString(data.mobileOtpVerifiedAt, 0, 64)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidServiceCategory(data) {
      return data.keys().hasAll(['code', 'name', 'status', 'createdByUid', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['id', 'code', 'name', 'description', 'status', 'proposedBy', 'approvedBy', 'createdByUid', 'createdAt', 'updatedAt']) &&
      isValidId(data.code) &&
      isBoundedString(data.name, 2, 120) &&
      data.status in ['active', 'pending_approval', 'archived'] &&
      isValidId(data.createdByUid) &&
      (!('description' in data) || isBoundedString(data.description, 0, 400)) &&
      (!('proposedBy' in data) || isBoundedString(data.proposedBy, 0, 64)) &&
      (!('approvedBy' in data) || data.approvedBy == null || isBoundedString(data.approvedBy, 0, 64)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidServiceItem(data) {
      return data.keys().hasAll([
        'serviceId', 'serviceCode', 'name', 'customerCharge', 'serviceCost',
        'profitAmount', 'status', 'availability', 'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'serviceId', 'serviceCode', 'name', 'categoryId', 'categoryName',
        'description', 'customerCharge', 'serviceCost', 'profitAmount', 'status',
        'availability', 'termsAndConditions', 'sla', 'requiredDocuments',
        'currentFormVersion', 'formVersions', 'automationRules', 'deletedAt',
        'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.serviceId) &&
      isBoundedString(data.serviceCode, 2, 64) &&
      isBoundedString(data.name, 2, 160) &&
      data.customerCharge is number &&
      data.serviceCost is number &&
      data.profitAmount is number &&
      data.status in ['Active', 'Inactive', 'Temporarily Suspended', 'Archived'] &&
      data.availability in ['Available', 'Unavailable'] &&
      isValidId(data.createdByUid) &&
      (!('description' in data) || isBoundedString(data.description, 0, 600)) &&
      (!('categoryName' in data) || isBoundedString(data.categoryName, 0, 120)) &&
      (!('termsAndConditions' in data) || isBoundedString(data.termsAndConditions, 0, 2000)) &&
      (!('requiredDocuments' in data) || (data.requiredDocuments is list && data.requiredDocuments.size() <= 30 && (data.requiredDocuments.size() == 0 || data.requiredDocuments[0] is map))) &&
      (!('formVersions' in data) || (data.formVersions is list && data.formVersions.size() <= 20 && (data.formVersions.size() == 0 || data.formVersions[0] is map))) &&
      (!('automationRules' in data) || (data.automationRules is list && data.automationRules.size() <= 20 && (data.automationRules.size() == 0 || data.automationRules[0] is map))) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidApplication(data) {
      return data.keys().hasAll([
        'applicationNo', 'customerId', 'serviceId', 'status',
        'createdByUid', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'applicationNo', 'financialYear', 'customerId', 'customerSnapshot',
        'serviceId', 'serviceSnapshot', 'formData', 'status', 'assignedStaffId',
        'assignedCounterCode', 'submissionDate', 'expectedCompletionDate',
        'actualCompletionDate', 'mandatoryDocExceptionReason', 'duplicateOverrideReason',
        'references', 'statusHistory', 'assignmentHistory', 'checklistSummary',
        'slaStatus', 'documents', 'financialSummary', 'payments', 'refunds',
        'followUps', 'notes', 'delivery', 'cancellations', 'reassignments',
        'notifications', 'activities', 'archivedAt', 'createdByUid', 'createdBy',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.applicationNo) &&
      isValidId(data.customerId) &&
      isValidId(data.serviceId) &&
      data.status in [
        'Draft', 'Submitted', 'Under Review', 'Processing',
        'Pending Customer', 'Pending Office', 'Approved', 'Rejected',
        'Completed', 'Cancelled', 'On Hold', 'Reopened'
      ] &&
      isValidId(data.createdByUid) &&
      isBoundedString(data.createdBy, 1, 64) &&
      (!('financialYear' in data) || isBoundedString(data.financialYear, 0, 20)) &&
      (!('expectedCompletionDate' in data) || isBoundedString(data.expectedCompletionDate, 0, 64)) &&
      (!('references' in data) || (data.references is list && data.references.size() <= 30 && (data.references.size() == 0 || data.references[0] is map))) &&
      (!('statusHistory' in data) || (data.statusHistory is list && data.statusHistory.size() <= 50 && (data.statusHistory.size() == 0 || data.statusHistory[0] is map))) &&
      (!('assignmentHistory' in data) || (data.assignmentHistory is list && data.assignmentHistory.size() <= 50 && (data.assignmentHistory.size() == 0 || data.assignmentHistory[0] is map))) &&
      (!('documents' in data) || (data.documents is list && data.documents.size() <= 30 && (data.documents.size() == 0 || data.documents[0] is map))) &&
      (!('payments' in data) || (data.payments is list && data.payments.size() <= 50 && (data.payments.size() == 0 || data.payments[0] is map))) &&
      (!('refunds' in data) || (data.refunds is list && data.refunds.size() <= 20 && (data.refunds.size() == 0 || data.refunds[0] is map))) &&
      (!('followUps' in data) || (data.followUps is list && data.followUps.size() <= 50 && (data.followUps.size() == 0 || data.followUps[0] is map))) &&
      (!('notes' in data) || (data.notes is list && data.notes.size() <= 100 && (data.notes.size() == 0 || data.notes[0] is map))) &&
      (!('cancellations' in data) || (data.cancellations is list && data.cancellations.size() <= 10 && (data.cancellations.size() == 0 || data.cancellations[0] is map))) &&
      (!('reassignments' in data) || (data.reassignments is list && data.reassignments.size() <= 20 && (data.reassignments.size() == 0 || data.reassignments[0] is map))) &&
      (!('notifications' in data) || (data.notifications is list && data.notifications.size() <= 50 && (data.notifications.size() == 0 || data.notifications[0] is map))) &&
      (!('activities' in data) || (data.activities is list && data.activities.size() <= 100 && (data.activities.size() == 0 || data.activities[0] is map))) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPayment(data) {
      return data.keys().hasAll([
        'transactionId', 'applicationNo', 'customerId', 'amount',
        'paymentMethod', 'verificationStatus', 'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'transactionId', 'receiptNo', 'invoiceNo', 'applicationNo',
        'customerId', 'customerName', 'serviceId', 'serviceName', 'counterCode',
        'collectedBy', 'paymentType', 'paymentMethod', 'upiReference', 'amount',
        'verificationStatus', 'verifiedBy', 'recordedAt', 'notes',
        'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.transactionId) &&
      isValidId(data.applicationNo) &&
      isValidId(data.customerId) &&
      data.amount is number && data.amount > 0 &&
      data.paymentMethod in ['Cash', 'UPI', 'Card', 'Bank Transfer', 'Other'] &&
      data.verificationStatus in ['Confirmed', 'Pending Verification', 'Rejected'] &&
      isValidId(data.createdByUid) &&
      (!('notes' in data) || isBoundedString(data.notes, 0, 400)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidExpense(data) {
      return data.keys().hasAll([
        'voucherNo', 'category', 'amount', 'status',
        'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'voucherNo', 'category', 'description', 'counterCode',
        'amount', 'expenseDate', 'recordedBy', 'status',
        'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.voucherNo) &&
      isBoundedString(data.category, 2, 80) &&
      data.amount is number && data.amount > 0 &&
      data.status in ['Approved', 'Pending'] &&
      isValidId(data.createdByUid) &&
      (!('description' in data) || isBoundedString(data.description, 0, 300)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidRefund(data) {
      return data.keys().hasAll([
        'refundId', 'applicationNo', 'refundAmount', 'status',
        'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'refundId', 'applicationNo', 'customerId', 'originalTransactionId',
        'refundType', 'refundAmount', 'refundMethod', 'refundReason', 'status',
        'requestedBy', 'approvedBy', 'processedBy', 'processedAt',
        'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.refundId) &&
      isValidId(data.applicationNo) &&
      data.refundAmount is number && data.refundAmount >= 0 &&
      data.status in ['Pending', 'Approved', 'Rejected', 'Processed'] &&
      isValidId(data.createdByUid) &&
      (!('refundReason' in data) || isBoundedString(data.refundReason, 0, 300)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSettingsDoc(data) {
      return data.keys().hasAll(['settingKey', 'updatedByUid', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly([
        'settingKey', 'companyProfile', 'globalConfig', 'userLanguage',
        'appearanceTheme', 'securityPolicy', 'printSettings', 'paymentQrSettings',
        'customerPrivacy', 'reportSettings', 'maintenanceSettings',
        'updatedByUid', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.settingKey) &&
      isValidId(data.updatedByUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSequence(data) {
      return data.keys().hasAll(['seqKey', 'currentValue', 'updatedByUid', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['seqKey', 'currentValue', 'updatedByUid', 'createdAt', 'updatedAt']) &&
      isValidId(data.seqKey) &&
      data.currentValue is number && data.currentValue >= 0 &&
      isValidId(data.updatedByUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSecurityLog(data) {
      return data.keys().hasAll(['eventType', 'actorUserId', 'summary', 'createdByUid', 'createdAt']) &&
      data.keys().hasOnly(['id', 'eventType', 'actorUserId', 'targetUserId', 'result', 'ipAddress', 'deviceInfo', 'summary', 'createdByUid', 'createdAt']) &&
      isBoundedString(data.eventType, 2, 64) &&
      isBoundedString(data.actorUserId, 1, 64) &&
      isBoundedString(data.summary, 1, 400) &&
      isValidId(data.createdByUid) &&
      data.createdAt is timestamp;
    }

    function isValidNotificationDispatch(data) {
      return data.keys().hasAll([
        'notificationId', 'customerId', 'channel', 'eventKey',
        'recipient', 'messagePreview', 'status', 'createdByUid', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'notificationId', 'applicationNo', 'customerId', 'channel',
        'eventKey', 'recipient', 'messagePreview', 'consentChecked',
        'consentGranted', 'status', 'statusReason', 'createdBy',
        'createdByUid', 'createdAt'
      ]) &&
      isValidId(data.notificationId) &&
      isBoundedString(data.customerId, 1, 64) &&
      data.channel in ['DASHBOARD', 'SMS', 'EMAIL_SMTP', 'WHATSAPP'] &&
      isBoundedString(data.eventKey, 1, 64) &&
      isBoundedString(data.recipient, 1, 160) &&
      isBoundedString(data.messagePreview, 1, 500) &&
      isBoundedString(data.status, 1, 64) &&
      isValidId(data.createdByUid) &&
      data.createdAt is timestamp;
    }

    function isValidDailyCashClosing(data) {
      return data.keys().hasAll([
        'closingCode', 'counterCode', 'closingDate', 'expectedCash',
        'actualCashCount', 'approvalStatus', 'createdByUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'closingCode', 'branchId', 'counterCode', 'closingDate',
        'openingCash', 'cashReceived', 'cashExpenses', 'expectedCash',
        'actualCashCount', 'cashDifference', 'differenceReason', 'submittedBy',
        'approvedBy', 'approvalStatus', 'correctionAudit', 'createdByUid',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.closingCode) &&
      isBoundedString(data.counterCode, 1, 40) &&
      isBoundedString(data.closingDate, 4, 32) &&
      data.expectedCash is number &&
      data.actualCashCount is number &&
      data.approvalStatus in ['Approved', 'Pending Admin Approval', 'Rejected'] &&
      isValidId(data.createdByUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection' && isSignedIn();
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create, update, delete: if isValidId(userId) && isAdmin() && isValidAdminMarker(incoming()) && incoming().updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin() || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin() || isAdmin();
      allow create: if isValidId(userId) &&
        (
          isBootstrappedAdmin() ||
          isAdmin() ||
          (isOwner(userId) && isValidUserPublic(incoming()) && incoming().uid == userId)
        );
      allow update: if isValidId(userId) &&
        (
          isBootstrappedAdmin() ||
          isAdmin() ||
          (isOwner(userId) && isValidUserPublic(incoming()))
        );
      allow delete: if isValidId(userId) && (isAdmin() || isBootstrappedAdmin());

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(docId) &&
          (isOwner(userId) || isAdmin()) &&
          isValidUserPrivate(incoming()) &&
          incoming().uid == userId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId) &&
          (isOwner(userId) || isAdmin()) &&
          isValidUserPrivate(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'mobile', 'address', 'totpEnabled', 'totpSecret', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    match /customers/{customerId} {
      allow get: if isValidId(customerId) && (isAdmin() || (isVerifiedUser() && existing().createdByUid == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().createdByUid == request.auth.uid);
      allow create: if isValidId(customerId) &&
        isActiveTeamMember() &&
        isValidCustomer(incoming()) &&
        incoming().customerId == customerId &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(customerId) &&
        isActiveTeamMember() &&
        isValidCustomer(incoming()) &&
        incoming().customerId == existing().customerId &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (existing().createdByUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'fatherOrHusbandName', 'dob', 'gender', 'mobile',
              'whatsapp', 'email', 'panNumber', 'voterId', 'village',
              'postOffice', 'policeStation', 'district', 'pinCode',
              'presentAddress', 'permanentAddress', 'sameAsPresent', 'segment',
              'crmTag', 'consents', 'consentHistory', 'contactHistory',
              'notesAndFollowUps', 'verificationStatus', 'mobileOtpVerifiedAt',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(customerId) && isAdmin();
    }

    match /serviceCategories/{categoryId} {
      allow get: if isValidId(categoryId) && isActiveTeamMember();
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().status in ['active', 'pending_approval', 'archived']);
      allow create: if isValidId(categoryId) &&
        isActiveTeamMember() &&
        isValidServiceCategory(incoming()) &&
        incoming().createdByUid == request.auth.uid &&
